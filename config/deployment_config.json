{
  "project": "DTC dual-endpoint prediction web deployment",
  "environment_locked": {
    "python": "3.11.15",
    "scikit-learn": "1.8.0",
    "catboost": "1.2.10",
    "joblib": "1.5.3",
    "numpy": "2.4.3",
    "pandas": "3.0.2"
  },
  "efficacy": {
    "model": "CatBoost",
    "positive_class": "Non-ER",
    "negative_class": "ER",
    "n_imputations": 5,
    "features": [
      "first_rai_activity",
      "number_metastatic",
      "pre_rai_tg",
      "surgery_to_rai_days",
      "pre_rai_tgab",
      "surgery_type__2",
      "surgery_type__3",
      "ata2025_risk",
      "max_ln_metastasis"
    ],
    "locked_threshold": 0.5767813999849822
  },
  "injury": {
    "model": "Logistic Regression",
    "positive_class": "Injury",
    "negative_class": "No injury",
    "n_imputations": 5,
    "features": [
      "first_rai_activity",
      "bmi",
      "parotid_peak_mean",
      "parotid_vitc_response_count",
      "rsm_t_half_uncensored_centered",
      "rsm_t_half_censored",
      "rsm_ef"
    ],
    "locked_threshold": 0.3983056793168745,
    "rsm_t_half_training_uncensored_mean_by_mi": {
      "1": 5.944897959183674,
      "2": 6.002083333333334,
      "3": 5.971134020618557,
      "4": 5.947959183673469,
      "5": 5.960824742268041
    }
  },
  "raw_input_encoding": {
    "surgery_type": {
      "Total": 1,
      "Near-total": 2,
      "Subtotal": 3,
      "reference": "Total",
      "dummy_rule": {
        "surgery_type__2": "1 only for Near-total, else 0",
        "surgery_type__3": "1 only for Subtotal, else 0"
      }
    },
    "ata2025_risk": {
      "Low": 0,
      "Low-intermediate": 1,
      "Intermediate-high": 2,
      "High": 3
    },
    "vitamin_c_response": {
      "Decreased": 0,
      "Increased": 1,
      "parotid_vitc_response_count": "lp_vitc_response + rp_vitc_response"
    },
    "parotid_peak_mean": "(lp_peak_count + rp_peak_count) / 2",
    "rsm_t_half_two_part": {
      "status_0": "Measurable",
      "status_1": "Prolonged beyond observation window",
      "formula": "(rsm_t_half - MI-specific Training uncensored mean) * (1 - rsm_t_half_censored)"
    }
  },
  "display_units": {
    "first_rai_activity": "mCi",
    "number_metastatic": "count",
    "pre_rai_tg": "ng/mL",
    "surgery_to_rai_days": "days",
    "pre_rai_tgab": "IU/mL",
    "max_ln_metastasis": "cm",
    "bmi": "kg/m²",
    "lp_peak_count": null,
    "rp_peak_count": null,
    "rsm_t_half": "min",
    "rsm_ef": "%"
  },
  "deployment_qc": {
    "internal_model_layer_reproduction": "passed",
    "end_to_end_raw_input_reproduction": "passed",
    "end_to_end_internal_n": 130,
    "end_to_end_excluded_mi_varying_input_n": 28,
    "probability_tolerance": 1e-12
  }
}